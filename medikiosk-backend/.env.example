# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=development                     # development | production
SECRET_KEY=change-me-32-char-minimum-secret-key
SESSION_TTL_SECONDS=900                 # 15 minutes

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database (Audit log only — no PHI) ───────────────────────────────────────
AUDIT_DATABASE_URL=postgresql+asyncpg://medikiosk:medikiosk@localhost:5432/medikiosk_audit

# ── Groq / LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=3000

# ── Bhashini ──────────────────────────────────────────────────────────────────
BHASHINI_API_KEY=...
BHASHINI_USER_ID=...
BHASHINI_ASR_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_TTS_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_CONFIDENCE_THRESHOLD=0.70
BHASHINI_ARBITRATION_WINDOW_MS=2500

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=medikiosk-ontology
PINECONE_ENVIRONMENT=us-east-1

# ── Google Cloud Document AI ──────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-service-account.json
GCP_PROJECT_ID=...
DOCUMENT_AI_PROCESSOR_ID=...            # Form Parser processor ID
DOCUMENT_AI_LOCATION=us                # or eu

# ── Hospital HIS / ABDM (mock for hackathon) ─────────────────────────────────
HIS_ENDPOINT=http://localhost:9000/api/fhir
ABDM_MOCK=true                          # true = write to local file; false = live ABDM

# ── Triage Pub/Sub ────────────────────────────────────────────────────────────
TRIAGE_PUBSUB_CHANNEL=triage:alerts

# ── Dialogue State Machine ────────────────────────────────────────────────────
MAX_TURNS=6
MAX_SESSION_MS=180000                   # 3 minutes
MIN_DOSHA_THRESHOLD=3.0                 # Minimum dosha accumulation before label
MIN_AGNI_CONFIDENCE=2.0                 # Minimum Agni score before classification
